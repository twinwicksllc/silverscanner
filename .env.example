# SuperNinja Silver Scanner - Environment Configuration

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
HOST=0.0.0.0
PORT=5000

# eBay API Configuration
# Set EBAY_USE_SANDBOX=False for production, True for testing
EBAY_USE_SANDBOX=False
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_DEV_ID=your-ebay-dev-id
EBAY_USER_TOKEN=your-ebay-user-token

# Deal Detection Settings
DEAL_THRESHOLD_PERCENTAGE=83.0
MIN_SELLER_FEEDBACK=98.0
SCAN_INTERVAL_MINUTES=15
MAX_ITEMS_PER_SCAN=200

# Email Notification Settings (Optional)
ENABLE_EMAIL_NOTIFICATIONS=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Logging
LOG_LEVEL=INFO